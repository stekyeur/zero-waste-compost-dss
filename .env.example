# Copy this file to .env and fill in your own Supabase project values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Kamera kaynağı: sanal/USB webcam numarası (DroidCam Client için "python kamera_bul.py" ile bulun)
# veya ağ akışı adresi, örn. KAMERA=http://172.20.10.1:4747/video
KAMERA=0

# --- Gateway (mqtt_dinleyici.py) ---
# Raspberry Pi'de broker aynı cihazda çalıştığı için 127.0.0.1 kalabilir.
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC=kompost/sensorler
# Deney bilgileri (isteğe bağlı)
ORNEK_ID=1
BILESEN_SINIFI=
FORMULASYON=
